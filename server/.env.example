LOG_LEVEL = debug
NODE_ENV = development

PORT = 3000

DB_URL = postgres://user:passowrd@localhost:5433/database_name
REDIS_URL = redis://localhost:6379

JWT_ACCESS_SECRET = replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN = 15m
REFRESH_TOKEN_EXPIRES_DAYS = 30

# One-time input for `bun run seed:manager`
# MANAGER_EMAIL = manager@example.com
# MANAGER_PASSWORD = at-least-12-characters
# MANAGER_FIRST_NAME: min(2) max(50)
# MANAGER_LAST_NAME: min(2) max(50)
# MANAGER_PHONE: min(7) max(20)
