{
  "name": "server",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "formatCheck": "prettier --c .",
    "format": "prettier --w . --l",
    "typecheck": "tsc --noEmit",
    "checkAll": "bun lint && bun formatCheck && bun typecheck",
    "fixAll": "bun lint:fix && bun format",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/structured-logger": "^0.1.0",
    "@hono/zod-openapi": "^1.5.1",
    "@scalar/hono-api-reference": "^0.11.11",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.12.31",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^1.0.0-rc.4-ca0f029",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.3"
  }
}
